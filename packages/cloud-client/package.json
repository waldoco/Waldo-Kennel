{
  "name": "@pin4sf/kennel-cloud-client",
  "version": "0.1.0",
  "private": true,
  "description": "Retained runtime-neutral TypeScript contracts for the inherited cloud API surface",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../contracts/cloud/openapi.yaml -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.4",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/waldoco/Waldo-Kennel.git",
    "directory": "packages/cloud-client"
  }
}
